DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yarn_manager
PORT=3000
# Random long string used to sign session cookies — change this in production
SESSION_SECRET=change-this-to-a-long-random-string

# ---- pg_dump/pg_restore: used by migrate-to-saas.js AND the live server's
# Settings > Backup feature. Full paths if not on PATH (e.g. Windows dev boxes):
# PG_DUMP_BIN=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# PG_RESTORE_BIN=C:\Program Files\PostgreSQL\17\bin\pg_restore.exe
#
# Required for Settings > Backup to actually back up every client, not just
# one: pg_dump/pg_restore must connect as a role that BYPASSES Row-Level
# Security (a superuser, or a dedicated role created with BYPASSRLS) — the
# app's normal DATABASE_URL role deliberately cannot (that's the whole point
# of FORCE ROW LEVEL SECURITY). Without this, manual/scheduled backups fail
# loudly rather than silently backing up only one client's data.
# BACKUP_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yarn_manager
# Name/password for the dedicated non-superuser role the migration creates
# for Row-Level Security to actually apply (defaults shown):
# SAAS_APP_ROLE=app_user
# SAAS_APP_ROLE_PASSWORD=leave unset to auto-generate a random one

# ---- Settings > Backup > "Backup Source Code" button: runs `git add/commit/push`
# in this project's own directory, pushing to whatever remote `origin` is
# already configured (set up once via `git remote add origin ...`). Full path
# if not on PATH (e.g. Windows dev boxes):
# GIT_BIN=C:\Program Files\Git\bin\git.exe
